# Packet Tracer IPC listener (Extensions > IPC > Options)
PT_HOST=127.0.0.1
PT_PORT=39000
# Must match <ID>/<KEY> in the registered exapp/PTMCP.pta
PT_APP_ID=net.netacad.cisco.ptmcp
PT_APP_KEY=ptmcp
# Optional: force an IPC API spec instead of auto-detecting (e.g. 8.2.0, 9.0.1)
# PT_API_SPEC=9.0.1
# Crash protection (see README): raw IPC tool and unverified methods are off by default
# PT_MCP_ENABLE_RAW_IPC=false
# PT_ALLOW_UNVERIFIED_IPC=false
# stdio (default) or http
PT_MCP_TRANSPORT=stdio
