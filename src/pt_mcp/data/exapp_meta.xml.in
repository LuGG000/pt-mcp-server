<?xml version="1.0" encoding = "iso-8859-1"?>
<!DOCTYPE PT_APP_META>
<PT_APP_META>
<PT_VERSION>@PT_VERSION@</PT_VERSION>
<IPC_VERSION>@PT_VERSION@</IPC_VERSION>
<NAME>PT MCP Bridge</NAME>
<VERSION>0.1.0</VERSION>
<ID>@APP_ID@</ID>
<DESCRIPTION>Lets an MCP client (e.g. Claude) drive Packet Tracer over IPC.</DESCRIPTION>
<AUTHOR>pt-mcp</AUTHOR>
<CONTACT>localhost</CONTACT>
<EXECUTABLE_PATH>@EXE_PATH@</EXECUTABLE_PATH>
<DETACHED>true</DETACHED>
<KEY>@APP_KEY@</KEY>
<SECURITY_SETTINGS>
<PRIVILEGE>GET_NETWORK_INFO</PRIVILEGE>
<PRIVILEGE>CHANGE_NETWORK_INFO</PRIVILEGE>
<PRIVILEGE>SIMULATION_MODE</PRIVILEGE>
<PRIVILEGE>MISC_GUI</PRIVILEGE>
<PRIVILEGE>FILE</PRIVILEGE>
<PRIVILEGE>CHANGE_PREFERENCES</PRIVILEGE>
<PRIVILEGE>CHANGE_GUI</PRIVILEGE>
<PRIVILEGE>IPC</PRIVILEGE>
<PRIVILEGE>APPLICATION</PRIVILEGE>
</SECURITY_SETTINGS>
<LOADING>ON_DEMAND</LOADING>
<SAVING>NEVER</SAVING>
<INSTANCES>1</INSTANCES>
<MANDATORY>false</MANDATORY>
</PT_APP_META>
